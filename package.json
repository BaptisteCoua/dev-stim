      "nuxt-osdd": "^1.0.5",
      "pg": "^8.20.0",
      "swiper": "^12.1.3",
      "vue": "^3.5.32",
      "vue-router": "^5.0.4",
      "vue3-toastify": "^0.2.9"
   },
   "devDependencies": {
      "@microsoft/eslint-formatter-sarif": "^3.1.0",
