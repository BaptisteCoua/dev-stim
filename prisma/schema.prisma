generator client {
  provider   = "prisma-client"
  output     = "./generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  pseudo       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  userJiras UserJira[]
}

model UserJira {
  id        String   @id @default(uuid())
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    String   @db.Uuid
  name      String
  email     String
  accountId String   @unique
  avatarUrl String
  tickets   Ticket[]
  stories   Story[]
}

model Ticket {
  id String @id @default(uuid())

  userJira   UserJira? @relation(fields: [userJiraId], references: [id])
  userJiraId String?
  status     Status?   @relation(fields: [statusId], references: [id])
  statusId   String?   @unique
  storys     Story[]

  ticketId     String   @unique
  name         String
  priority     String
  createdAt    DateTime
  ticketPoints Int
  type         String
}

model Story {
  id String @id @default(uuid())

  userJira   UserJira? @relation(fields: [userJiraId], references: [id])
  userJiraId String?
  status     Status?   @relation(fields: [statusId], references: [id])
  statusId   String?   @unique
  version    Version?  @relation(fields: [versionId], references: [id])
  versionId  String?   @unique
  sprint     Sprint?   @relation(fields: [sprintId], references: [id])
  sprintId   String?   @unique
  tickets    Ticket[]

  storyId     String   @unique
  name        String
  storyPoints Decimal
  createdAt   DateTime
  priority    String
}

model Status {
  id     String  @id @default(uuid())
  label  String
  ticket Ticket?
  story  Story?
}

model Version {
  id String @id @default(uuid())

  storys Story[]

  versionJiraId String   @unique
  name          String
  description   String
  releaseDate   DateTime
  startDate     DateTime
  progress      DateTime
  archived      Boolean
  released      Boolean
  overdue       Boolean
}

model Sprint {
  id     String  @id @default(uuid())
  storys Story[]

  sprintJiraId  String    @unique
  name          String
  startDate     DateTime?
  endDate       DateTime?
  state         String?
  originBoardId String?
  createdDate   DateTime
  completeDate  String?
}

model ProductionHealth {
  id         String    @id @default(uuid())
  ok         Boolean
  status     Int
  statusText String
  durationMs Int
  createdAt  DateTime  @default(now())

  @@map("production_health")
}
